---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';

const items = (await getCollection('experience', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    href: `/experience/${e.id}`,
    date: e.data.period,
    title: e.data.title,
    summary: e.data.summary,
    thumbnail: e.data.thumbnail
  }));
const page = (await getEntry('pages', 'experience-index'))!.data;
---

<Base title={page.title!} description={page.lede}>
  <h1>{page.title}</h1>
  <p class="meta">{page.lede}</p>
  <EntryList items={items} />
</Base>
