---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { shortDate } from '../../format';

const items = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((e) => ({
    href: `/writing/${e.id}`,
    date: shortDate(e.data.date),
    title: e.data.title,
    summary: e.data.summary,
    thumbnail: e.data.thumbnail
  }));
const page = (await getEntry('pages', 'writing-index'))!.data;
---

<Base title={page.title!} description={page.lede}>
  <h1>{page.title}</h1>
  <p class="meta">{page.lede}</p>
  {items.length > 0 ? <EntryList items={items} tinted={true} /> : <p>No pieces are published yet.</p>}
</Base>
