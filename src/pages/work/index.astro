---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';

const items = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    href: `/work/${e.id}`,
    date: e.data.period,
    title: e.data.title,
    summary: e.data.summary
  }));
---

<Base title="Work" description="A few things in more detail than a CV allows.">
  <h1>Work</h1>
  <p class="meta">A few things in more detail than a CV allows, including the parts that went wrong.</p>
  <EntryList items={items} />
</Base>
