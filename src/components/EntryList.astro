---
interface Item {
  href: string;
  date: string;
  title: string;
  summary: string;
  thumbnail?: string;
}

interface Props {
  items: Item[];
  tinted?: boolean;
}

const { items, tinted = false } = Astro.props;
const hasThumbs = items.some((i) => i.thumbnail);
---

<div class={`entries${tinted ? ' tinted' : ''}${hasThumbs ? ' with-thumbs' : ''}`}>
  {items.map((item) => (
    <article class="entry">
      <div class="entry-date">{item.date}</div>
      {hasThumbs && (
        <a class="entry-thumb" href={item.href} tabindex="-1" aria-hidden="true">
          {item.thumbnail && <img src={item.thumbnail} alt="" loading="lazy" />}
        </a>
      )}
      <div class="entry-body">
        <a class="entry-title" href={item.href}>{item.title}</a>
        <p class="entry-summary">{item.summary}</p>
      </div>
    </article>
  ))}
</div>
