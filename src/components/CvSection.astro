---
interface Item {
  href?: string;
  title: string;
  period: string;
  org?: string;
  logo?: string;
  bullets: string[];
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="cv-block">
  {items.map((item) => (
    <article class="cv-entry">
      <div class="cv-head">
        {item.logo && (
          item.href
            ? <a class="cv-logo" href={item.href} aria-hidden="true" tabindex="-1"><img src={item.logo} alt="" loading="lazy" /></a>
            : <span class="cv-logo"><img src={item.logo} alt="" loading="lazy" /></span>
        )}
        {item.href
          ? <a class="cv-title" href={item.href}>{item.title}</a>
          : <span class="cv-title cv-title-plain">{item.title}</span>}
        <span class="cv-period">{item.period}</span>
      </div>
      {item.org && <p class="cv-org">{item.org}</p>}
      {item.bullets.length > 0 && (
        <ul class="cv-bullets">
          {item.bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}
    </article>
  ))}
</div>
