---
interface Item {
  href?: string;
  title: string;
  period: string;
  org?: string;
  logo?: string;
  bullets: string[];
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const hasLogos = items.some((i) => i.logo);
---

<div class={`cv-block${hasLogos ? ' with-logos' : ''}`}>
  {items.map((item) => (
    <article class="cv-entry">
      <div class="cv-head">
        {hasLogos && (
          <span class="cv-logo">
            {item.logo && <img src={item.logo} alt="" loading="lazy" />}
          </span>
        )}
        {item.href
          ? <a class="cv-title" href={item.href}>{item.title}</a>
          : <span class="cv-title cv-title-plain">{item.title}</span>}
        <span class="cv-period">{item.period}</span>
      </div>
      {item.org && <p class="cv-org">{item.org}</p>}
      {item.bullets.length > 0 && (
        <ul class="cv-bullets">
          {item.bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}
    </article>
  ))}
</div>
