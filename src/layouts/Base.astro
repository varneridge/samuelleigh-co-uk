---
import '@fontsource-variable/archivo';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title: string;
  description?: string;
}

const s = (await getEntry('pages', 'settings'))!.data;
const { title, description = `${s.name}: writing, experience and CV.` } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: s.navAbout },
  { href: '/education', label: s.navEducation },
  { href: '/writing', label: s.navWriting },
  { href: '/experience', label: s.navExperience },
  { href: '/projects', label: s.navProjects }
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === s.name ? title : `${title}, ${s.name}`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="page">
      <header class="rail">
        <div class="rail-id">
          {s.photo && <img class="rail-photo" src={s.photo} alt={s.name} width="660" height="900" />}
          <div>
            <a class="rail-name" href="/">{s.name}</a>
            <p class="rail-place">{s.place}</p>
          </div>
        </div>
        <nav aria-label="Main">
          <ul class="rail-nav">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <p class="rail-note">{s.note}</p>
        <p class="rail-contact">
          <a href={`mailto:${s.email}`}>{s.email}</a><br />
          <a href={s.linkedin}>LinkedIn</a>
        </p>
      </header>
      <main>
        <slot />
        <footer class="site-footer">
          <a href={`mailto:${s.email}`}>{s.email}</a><br />
          <a href={s.linkedin}>LinkedIn</a>
        </footer>
      </main>
    </div>
  </body>
</html>
